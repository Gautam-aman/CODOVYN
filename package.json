{
  "name": "codovyn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "displayName": "CODOVYN",
  "publisher": "codovyn-local",
  "description": "Local-first agent tasks and visible handoffs inside VS Code",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gautam-aman/CODOVYN.git"
  },
  "main": "./apps/vscode-extension/extension.cjs",
  "engines": {
    "node": ">=26.12.1",
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codovyn.open",
        "title": "CODOVYN: Open Agent Workspace"
      },
      {
        "command": "codovyn.openChat",
        "title": "CODOVYN: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codovyn.openActivity",
        "title": "CODOVYN: View Task Activity"
      },
      {
        "command": "codovyn.openRecentTasks",
        "title": "CODOVYN: Open Recent Tasks"
      },
      {
        "command": "codovyn.openAgentSettings",
        "title": "CODOVYN: Open Agent Settings"
      },
      {
        "command": "codovyn.openRoutingSettings",
        "title": "CODOVYN: Open Model Routing Settings"
      },
      {
        "command": "codovyn.openRepositoryDiff",
        "title": "CODOVYN: Open Repository Diff"
      },
      {
        "command": "codovyn.codexSignIn",
        "title": "CODOVYN: Sign In to Codex (Isolated)"
      },
      {
        "command": "codovyn.codexValidateAsk",
        "title": "CODOVYN: Validate One Codex Ask (Approval Required)"
      },
      {
        "command": "codovyn.codexSignOut",
        "title": "CODOVYN: Sign Out of Isolated Codex"
      },
      {
        "command": "codovyn.codexCancel",
        "title": "CODOVYN: Cancel Isolated Codex Session"
      },
      {
        "command": "codovyn.codexAuthStatus",
        "title": "CODOVYN: Refresh Isolated Codex Sign-In Status"
      }
    ],
    "configuration": {
      "title": "CODOVYN",
      "properties": {
        "codovyn.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Path to a Node.js 26 or newer executable used by the local runtime."
        },
        "codovyn.geminiCliPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional absolute path to an executable Gemini CLI. Set this in user settings when Gemini is installed outside CODOVYN's PATH. Authentication remains managed by the official CLI."
        },
        "codovyn.routingPolicy": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "restricted": true,
          "description": "Explicit local model catalogue and routing policy. Edit in the CODOVYN agent workspace or Settings JSON; no prices or model access are inferred. See docs/agents/routing.md."
        },
        "codovyn.opencodeCliPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Optional absolute path to the official OpenCode 2.1.2 executable. CODOVYN uses an isolated provider context and never imports global credentials or plugins."
        },
        "codovyn.codexNativePath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute path to the supported official native Codex 0.164.0 macOS ARM64 executable. Integrity-pinned; no global credentials are imported."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "codovyn.openChat",
          "group": "navigation@9"
        }
      ]
    }
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check-syntax.js && node --test --test-concurrency=1",
    "test:extension-host": "node scripts/run-extension-host.js",
    "vscode:prepublish": "npm run check",
    "package:extension": "vsce package --no-dependencies --githubBranch main --out codovyn-dev.vsix",
    "build:desktop": "node apps/desktop/build/macos.js",
    "test:desktop-host": "node scripts/run-desktop-host.js",
    "test:desktop-chat": "node scripts/run-desktop-chat.js",
    "package:desktop": "node apps/desktop/build/dmg.js",
    "test:desktop-restoration": "node scripts/run-desktop-restoration.js",
    "test:desktop-routing-ui": "node scripts/desktop-routing-ui-smoke.js"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0"
  }
}
